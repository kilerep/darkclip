# Copie para .env e preencha o que for usar.
ANTHROPIC_API_KEY=          # IA Claude: escolhe os melhores trechos, títulos e roteiros (sem ela = heurística)
GEMINI_API_KEY=             # IA que ASSISTE o vídeo (imagem + áudio). Grátis: https://aistudio.google.com/apikey
DARKCLIP_GEMINI_MODEL=gemini-4-hydrogen
DARKCLIP_GEMINI_FALLBACKS=gemini-3.8-flash,gemini-3.5-flash-lite   # reservas se o principal estiver ocupado (erro 503)
DARKCLIP_MODEL=claude-opus-5-5
DARKCLIP_OLLAMA_MODEL=      # 100% offline e grátis: instale o Ollama e rode "ollama pull qwen3:8b" (ex.: qwen3:8b)
DARKCLIP_WHISPER_MODEL=small  # transcrição local p/ vídeos sem legenda (base = mais rápido, medium = mais preciso)
DARKCLIP_EFFORT=medium
DARKCLIP_TOKEN=             # senha do app (OBRIGATÓRIO se o servidor ficar acessível na rede/internet)
DARKCLIP_VOICE=pt-BR-AntonioNeural
DARKCLIP_PRESET=veryfast    # no celular use ultrafast
DARKCLIP_ENCODER=libx264    # Android/Termux: h264_mediacodec (usa o chip de vídeo, bem mais rápido)
DARKCLIP_COOKIES=           # caminho de um cookies.txt do YouTube (só se aparecer "confirme que não é robô")
# Publicação automática (opcional) via Postiz: npm i -g postiz
POSTIZ_API_KEY=
POSTIZ_YOUTUBE_ID=          # ID da integração do YouTube (postiz integrations:list)
